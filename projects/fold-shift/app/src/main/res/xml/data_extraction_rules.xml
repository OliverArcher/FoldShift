<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ data extraction rules. FoldShift keeps no user data
     beyond the launcher package names, so backups are denied outright. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>